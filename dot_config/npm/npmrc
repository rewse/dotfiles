# Disable lifecycle scripts by default for security
# This prevents malicious packages from executing code during installation
ignore-scripts=true

# Store the npm cache and logs under XDG directories instead of ~/.npm
cache=${XDG_CACHE_HOME}/npm
logs-dir=${XDG_STATE_HOME}/npm/logs

# Install only versions published at least 4 days ago, matching
# supply_chain_cooldown_days in ansible-playbooks.
min-release-age=4
