{
  "imports": [],
  "mcpServers": {
    "analytics-mcp": {
      "command": "uvx",
      "args": [
        "analytics-mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "{{ .chezmoi.homeDir }}/.config/gcloud/application_default_credentials.json",
        "GOOGLE_PROJECT_ID": "analytics-mcp-492303"
      }
    },
    "aws-mcp": {
      "command": "uvx",
      "args": [
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=ap-northeast-1"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "chrome-devtools-mcp@latest"
      ]
    },
    "drawio": {
      "command": "npx",
      "args": [
        "@drawio/mcp"
      ]
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    },
    "home-assistant": {
      "command": "uvx",
      "args": [
        "ha-mcp@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR",
        "HOMEASSISTANT_URL": "{{ onepasswordRead "op://chezmoi/aghd2uptzcjbjfxgj56nd3xlmu/url" }}",
        "HOMEASSISTANT_TOKEN": "{{ onepasswordRead "op://chezmoi/aghd2uptzcjbjfxgj56nd3xlmu/credential" }}"
      }
    },
    "ticktick": {
      "url": "https://mcp.ticktick.com",
      "oauthScopes": []
    },
    "unifi-network": {
      "command": "uvx",
      "args": ["unifi-network-mcp@latest"],
      "env": {
        "UNIFI_NETWORK_HOST": "{{ onepasswordRead "op://chezmoi/epimjkq3c2rh3bctjnhmslp5ce/hostname" }}",
        "UNIFI_NETWORK_USERNAME": "{{ onepasswordRead "op://chezmoi/epimjkq3c2rh3bctjnhmslp5ce/username" }}",
        "UNIFI_NETWORK_PASSWORD": "{{ onepasswordRead "op://chezmoi/epimjkq3c2rh3bctjnhmslp5ce/credential" }}"
      }
    },
    "zabbix": {
      "url": "https://zabbix-mcp.rewse.jp/mcp",
      "headers": {
        "Authorization": "Bearer {{ onepasswordRead "op://chezmoi/qqxykwkik2v7foe3gmlkef2sme/credential" }}"
      }
    }
{{- /* ~/git/dotfiles-internal adds the servers for Amazon-internal systems. */}}
{{- $internal := joinPath .chezmoi.homeDir "git" "dotfiles-internal" ".chezmoitemplates" "mcporter" "servers.json" }}
{{- if stat $internal }}
{{-   range $name, $server := includeTemplate $internal . | fromJson }},
    {{ toJson $name }}: {{ toPrettyJson "  " $server | trim | replace "\n" "\n    " }}
{{-   end }}
{{- end }}
  }
}
