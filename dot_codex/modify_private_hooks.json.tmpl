#!/bin/bash
# Register this repository's Codex hooks. Otty writes its own entries to the
# same file, so patch it in place instead of owning the whole file, and pass
# the file through byte for byte once every hook is present.

set -euo pipefail

away_continue='{{ .chezmoi.homeDir }}/.agents/hooks/away-continue.py codex'
enforce_uv='{{ .chezmoi.homeDir }}/.agents/hooks/enforce-uv.sh'

# Keep a trailing newline, if any, so an unchanged file stays byte-identical.
current=$(cat; printf x)
current=${current%x}

if [[ -n "$current" ]] &&
   jq -e --arg away_continue "$away_continue" --arg enforce_uv "$enforce_uv" '
     any(.hooks.PreToolUse[]?.hooks[]?; .command == $enforce_uv) and
     any(.hooks.Stop[]?.hooks[]?; .command == $away_continue)
   ' <<<"$current" >/dev/null; then
  printf '%s' "$current"
  exit 0
fi

jq --indent 2 --arg away_continue "$away_continue" --arg enforce_uv "$enforce_uv" '
  def has_hook(event; command):
    any(.hooks[event][]?.hooks[]?; .command == command);
  if has_hook("PreToolUse"; $enforce_uv) then . else
    .hooks.PreToolUse += [{matcher: "^Bash$", hooks: [{type: "command", command: $enforce_uv}]}]
  end
  | if has_hook("Stop"; $away_continue) then . else
    .hooks.Stop += [{hooks: [{type: "command", command: $away_continue}]}]
  end
' <<<"${current:-"{}"}"
