[default]
region = ap-northeast-1
output = yaml
{{- if eq .chezmoi.hostname "7cf34ded5d65" }}
credential_process = isengardcli credentials --role ReadOnly --awscli 070392599442

[profile admin]
region = ap-northeast-1
output = yaml
credential_process = isengardcli credentials --role Admin --awscli 070392599442
{{- end }}

{{- $sourceProfile := "" }}
{{- if eq .chezmoi.hostname "7cf34ded5d65" }}
{{-   $sourceProfile = "admin" }}
{{- else if has .chezmoi.hostname (list "fox" "hotel" "youth") }}
{{-   $sourceProfile = "default" }}
{{- end }}

{{- if $sourceProfile }}

[profile bedrock]
region = us-west-2
output = yaml
role_arn = arn:aws:iam::070392599442:role/bedrock
source_profile = {{ $sourceProfile }}

[profile cloudfront-waf-deploy]
