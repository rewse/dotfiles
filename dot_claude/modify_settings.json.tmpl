#!/bin/bash
# Register this repository's Claude Code hooks. Corporate tools and Otty
# rewrite this file, so patch it in place instead of owning the whole file,
# and pass the file through byte for byte once every hook is present.

set -euo pipefail

away_continue='{{ .chezmoi.homeDir }}/.agents/hooks/away-continue.py claude'
enforce_uv='{{ .chezmoi.homeDir }}/.agents/hooks/enforce-uv.sh'
japanese_guard='{{ .chezmoi.homeDir }}/.agents/hooks/japanese-guard.py'
superpowers='{{ .chezmoi.homeDir }}/.agents/hooks/superpowers-session-start.sh claude'
gates='{{ .chezmoi.homeDir }}/.agents/hooks/superpowers-gates/claude'

# Keep a trailing newline, if any, so an unchanged file stays byte-identical.
current=$(cat; printf x)
current=${current%x}

if [[ -n "$current" ]] &&
   jq -e --arg away_continue "$away_continue" --arg enforce_uv "$enforce_uv" \
     --arg japanese_guard "$japanese_guard" --arg superpowers "$superpowers" \
     --arg gates "$gates" '
     any(.hooks.PreToolUse[]?.hooks[]?; .command == $enforce_uv) and
     any(.hooks.SessionStart[]?.hooks[]?; .command == $superpowers) and
     any(.hooks.Stop[]?.hooks[]?; .command == $japanese_guard) and
     any(.hooks.Stop[]?.hooks[]?; .command == $away_continue) and
     any(.hooks.PreToolUse[]?.hooks[]?; .command == ($gates + " pre-tool-use")) and
     any(.hooks.PostToolUse[]?.hooks[]?; .command == ($gates + " post-tool-use")) and
     any(.hooks.SessionStart[]?.hooks[]?; .command == ($gates + " session-start")) and
     any(.hooks.UserPromptSubmit[]?.hooks[]?; .command == ($gates + " user-prompt-submit"))
   ' <<<"$current" >/dev/null; then
  printf '%s' "$current"
  exit 0
fi

jq --indent 2 --arg away_continue "$away_continue" --arg enforce_uv "$enforce_uv" \
  --arg japanese_guard "$japanese_guard" --arg superpowers "$superpowers" \
  --arg gates "$gates" '
  def has_hook(event; command):
    any(.hooks[event][]?.hooks[]?; .command == command);
  if has_hook("PreToolUse"; $enforce_uv) then . else
    .hooks.PreToolUse += [{matcher: "Bash", hooks: [{type: "command", command: $enforce_uv}]}]
  end
  | if has_hook("SessionStart"; $superpowers) then . else
    .hooks.SessionStart += [{matcher: "startup|clear|compact", hooks: [{type: "command", command: $superpowers}]}]
  end
  | if has_hook("Stop"; $japanese_guard) then . else
    .hooks.Stop += [{hooks: [{type: "command", command: $japanese_guard}]}]
  end
  | if has_hook("Stop"; $away_continue) then . else
    .hooks.Stop += [{hooks: [{type: "command", command: $away_continue}]}]
  end
  | if has_hook("PreToolUse"; $gates + " pre-tool-use") then . else
    .hooks.PreToolUse += [{matcher: "Write|Edit|MultiEdit", hooks: [{type: "command", command: ($gates + " pre-tool-use")}]}]
  end
  | if has_hook("PostToolUse"; $gates + " post-tool-use") then . else
    .hooks.PostToolUse += [{matcher: "Read|Skill|Bash|Write|Edit|MultiEdit", hooks: [{type: "command", command: ($gates + " post-tool-use")}]}]
  end
  | if has_hook("SessionStart"; $gates + " session-start") then . else
    .hooks.SessionStart += [{matcher: "compact", hooks: [{type: "command", command: ($gates + " session-start")}]}]
  end
  | if has_hook("UserPromptSubmit"; $gates + " user-prompt-submit") then . else
    .hooks.UserPromptSubmit += [{hooks: [{type: "command", command: ($gates + " user-prompt-submit")}]}]
  end
' <<<"${current:-"{}"}"
