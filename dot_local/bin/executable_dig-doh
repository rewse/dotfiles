#!/bin/bash
#
# Resolve a name over DNS-over-HTTPS and print the answers the way `dig +short`
# does. A gateway that filters DNS by content category enforces it by answering
# every port 53 packet itself, so plain lookups from inside such a network report
# the internal address no matter which resolver they name. Port 443 is untouched.

set -u

RESOLVER="${DIG_DOH_RESOLVER:-https://cloudflare-dns.com/dns-query}"

usage() {
    cat <<'EOF'
Usage: dig-doh <name> [type]

Resolve <name> over DoH and print one record per line. Type defaults to A.
Set DIG_DOH_RESOLVER to query somewhere other than Cloudflare.

  dig-doh example.com
  dig-doh example.com MX
EOF
}

if [ "$#" -lt 1 ]; then
    usage >&2
    exit 2
fi

if [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    exit 0
fi

NAME="$1"
TYPE="${2:-A}"

RESPONSE=$(curl -sS -m 10 -H 'accept: application/dns-json' \
    --get --data-urlencode "name=${NAME}" --data-urlencode "type=${TYPE}" \
    "${RESOLVER}") || exit 1

STATUS=$(printf '%s' "${RESPONSE}" | jq -r '.Status // empty')

case "${STATUS}" in
    0)
        ;;
    3)
        echo "dig-doh: ${NAME}: NXDOMAIN" >&2
        exit 1
        ;;
    '')
        echo "dig-doh: unexpected answer: ${RESPONSE:0:200}" >&2
        exit 1
        ;;
    *)
        echo "dig-doh: ${NAME}: rcode ${STATUS}" >&2
        exit 1
        ;;
esac

printf '%s' "${RESPONSE}" | jq -r '.Answer // [] | .[] | .data'
