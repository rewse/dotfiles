{
  "name": "main",
  "description": "",
  "prompt": null,
{{- /* ~/git/dotfiles-internal adds the servers for Amazon-internal systems. */}}
{{- $internalServers := joinPath .chezmoi.homeDir "git" "dotfiles-internal" ".chezmoitemplates" "kiro" "agent-mcp-servers.json" }}
{{- if stat $internalServers }}
  "mcpServers": {{ includeTemplate $internalServers . | trim | replace "\n" "\n  " }},
{{- else }}
  "mcpServers": {},
{{- end }}
  "includeMcpJson": true,
  "tools": ["*"],
  "toolAliases": {},
  "resources": [
    "file://AGENTS.md",
    "file://CLAUDE.md",
    "file://.kiro/steering/**/*.md",
    "file://~/.kiro/steering/**/*.md",
{{- /* ~/.agents/skills is omitted because ~/.kiro/skills already symlinks to each skill there, and listing both would load every skill twice. */}}
    "skill://.agents/skills/**/SKILL.md",
    "skill://.kiro/skills/**/SKILL.md",
    "skill://~/.kiro/skills/**/SKILL.md"
  ],
  "permissions": {
    "policies": ["read-workspace"],
    "rules": []
  }
}
