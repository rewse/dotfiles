# approve-for-me judges shell commands and the other operations that no rule
# below settles, except file operations outside the workspace, which prompt.
policies: ["approve-for-me"]
rules:
  # /tmp, ~/Desktop, and ~/Downloads are outside the workspace, so without
  # these allows every read and write there would prompt.
  - capability: fs_read
    effect: allow
    match:
      - "."
      - "./**"
      - "/private/tmp/**"
      - "/tmp/**"
      - "~/Desktop/**"
      - "~/Downloads/**"
  - capability: fs_write
    effect: allow
    match:
      - "./**"
      - "/private/tmp/**"
      - "/tmp/**"
      - "~/Desktop/**"
      - "~/Downloads/**"
  - capability: skill
    effect: allow
  - capability: subagent
    effect: allow
{{- /* ~/git/dotfiles-internal adds the rules for Amazon-internal systems. */}}
{{- $internalRules := joinPath .chezmoi.homeDir "git" "dotfiles-internal" ".chezmoitemplates" "kiro" "permission-rules.yaml" }}
{{- if stat $internalRules }}
{{ include $internalRules | trim | indent 2 }}
{{- end }}
