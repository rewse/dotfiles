# approve-for-me judges shell commands and the other operations that no rule
# below settles, except file operations outside the workspace, which prompt.
policies: ["approve-for-me"]
rules:
  # /tmp, ~/Desktop, and ~/Downloads are outside the workspace, so without
  # these allows every read and write there would prompt.
  - capability: fs_read
    effect: allow
    match:
      - "."
      - "./**"
      - "/private/tmp/**"
      - "/tmp/**"
      - "~/Desktop/**"
      - "~/Downloads/**"
  - capability: fs_write
    effect: allow
    match:
      - "./**"
      - "/private/tmp/**"
      - "/tmp/**"
      - "~/Desktop/**"
      - "~/Downloads/**"
  - capability: skill
    effect: allow
  - capability: subagent
    effect: allow
{{- if eq .chezmoi.hostname "7cf34ded5d65" }}
  - capability: mcp
    effect: allow
    match:
      - "builder-mcp/ReadInternalWebsites"
{{- end }}
